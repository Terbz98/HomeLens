# Copy this file to .env and fill in real values. Never commit .env.

# Mapillary client token (free): https://www.mapillary.com/dashboard/developers
# Leave empty to run in location-only mode.
MAPILLARY_TOKEN=

# Set to 1 to serve models trained on the synthetic fixtures (clearly labeled demo output).
HOMELENS_DEMO=0

# ID of the loaded Chrome extension (shown on chrome://extensions). When set, only this
# extension may call the backend. When empty, any chrome-extension:// origin is accepted.
HOMELENS_EXTENSION_ID=

# Extra allowed web origins, comma separated. Only needed for the local UI preview page.
HOMELENS_EXTRA_ORIGINS=

# Address lookup services to try, in order. Allowed: nominatim (OpenStreetMap), census (US Census Bureau).
# The Census service does not answer from some networks outside the United States.
HOMELENS_GEOCODERS=nominatim,census
